# Makefile.local for Dustin's 2023 MacBook (M3 chip), MacOS 15.7; Homebrew Python3.14

# Directory where C++ libraries will be installed
LIBDIR ?= $(HOME)/chime/lib

# Directory where C++ header files will be installed
INCDIR ?= $(HOME)/chime/include

# Directory where Python modules will be installed
# Don't forget to add $(PYDIR) to your PYTHONPATH environment variable
PYDIR ?= $(HOME)/lib/python2.7/site-packages

# Read-only location of python header files, needed for cython
#Hint for PYTHON_INCDIR: import distutils.sysconfig; distutils.sysconfig.get_python_inc()
#PYTHON_INCDIR=/usr/include/python2.7
PYTHON_CFLAGS ?= $(shell python3-config --cflags)

# Hint for NUMPY_INCDIR: import numpy; numpy.get_include()
NUMPY_INCDIR ?= $(shell python3 -c "import numpy; print(numpy.get_include())")

FFTW_INC ?= $(shell pkg-config --cflags fftw3)
FFTW_LIB ?= $(shell pkg-config --libs fftw3)

# C++ command line
# Must support c++11
CPP=clang -std=c++11 -Wall -O3 -march=native -ffast-math -funroll-loops -I. -I$(INCDIR) $(PYTHON_CFLAGS) -I$(NUMPY_INCDIR) $(FFTW_INC) -I/usr/local/include

# Extra linker flags when creating a shared library or exectutable from .o files
# Don't forget to add . and $(LIBDIR) in your LD_LIBRARY_PATH environment variable (in this order)
# Don't forget -fPIC
#CPP_LFLAGS=-fPIC -L. -L$(LIBDIR) -lc++
CPP_LFLAGS ?= -fPIC -L. -L$(LIBDIR) $(shell python3-config --ldflags) $(FFTW_LIB) -lc++ -L/usr/local/lib

PYVER ?= $(shell python3 -c "from sys import version_info as v; print('python%i.%i' % (v.major, v.minor))")
LIBS_PYMODULE=-l$(PYVER)

# Cython flags - numpy inc
CYTHON_FLAGS ?= -I$(NUMPY_INCDIR) -ENPY_NO_DEPRECATED_API=NPY_1_7_API_VERSION
